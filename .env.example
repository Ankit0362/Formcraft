# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dev"

# Session encryption (REQUIRED - generate a random 64+ char string)
# Example: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8000/api/authentication/google/callback"

# Frontend URL
NEXT_PUBLIC_API_URL="http://localhost:8000/trpc"

# API Server
PORT=8000
NODE_ENV=development
BASE_URL="http://localhost:8000"
ALLOWED_ORIGINS="http://localhost:3000"
SESSION_SECURE="false"
BASE_URL="http://localhost:8000"
